# =============================================================
#  Agente HTML - Configuración de proveedor de IA
#  Copia este archivo como .env y ajusta los valores
# =============================================================

# Proveedor a usar: ollama | openai | anthropic | nvidia
PROVIDER=ollama

# --- Ollama (modelo local, sin costo) ----------------------
# Requiere tener Ollama instalado: https://ollama.com
# Modelos recomendados: qwen2.5-coder:7b, llama3.1:8b, mistral
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI -----------------------------------------------
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) -----------------------------------
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- NVIDIA NIM (endpoints gratuitos, muchos modelos) -----
# Obtén tu clave GRATIS en: https://build.nvidia.com
# La key empieza con: nvapi-
# Modelos recomendados para HTML:
#   qwen/qwen3-235b-a22b         (muy bueno para código)
#   meta/llama-4-maverick-17b-128e-instruct
#   mistralai/mistral-large-2-instruct
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=qwen/qwen3-235b-a22b
